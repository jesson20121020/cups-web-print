# ===== 钉钉企业内部应用（开放平台 → 应用开发 → 企业内部应用）=====
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# 企业内部机器人默认与 AppKey 相同，留空自动填
DINGTALK_ROBOT_CODE=

# 只允许这些钉钉 staffId 触发打印，逗号分隔；留空=不限制（谁都能往你家打印机发东西，不建议）
ALLOW_USER_IDS=

# ===== 打印服务 =====
# 互动卡片模板 ID（在卡片平台创建并发布后填）
CARD_TEMPLATE_ID=
PRINT_SERVICE=http://192.168.31.190:5000
# 留空自动选第一台 IPP 队列（TS3380-IPPS）
PRINTER_NAME=
REQUEST_TIMEOUT=60

# ===== 默认打印参数（与网页/skill 默认一致）=====
DEFAULT_COLOR=color
DEFAULT_DUPLEX=two-sided-long-edge
DEFAULT_PAPER=A4
DEFAULT_PAPER_TYPE=plain
DEFAULT_ORIENTATION=portrait
DEFAULT_SCALING=fit

# ===== 行为 =====
# 连发多张图的合并静默窗口（秒）
BATCH_WINDOW_SECONDS=8
# 待确认任务有效期（分钟）
PENDING_TTL_MINUTES=30
# 等打印结果的上限（秒）
JOB_TIMEOUT_SECONDS=300
INBOX_DIR=/data/inbox

# 允许触发的群 conversationId（逗号分隔）：群里 @机器人 也能打印
ALLOW_GROUP_IDS=
