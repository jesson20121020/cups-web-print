#!/bin/bash
# upgrade_callback — 升级后（应用文件已替换为新版本）
# 与 install_callback 类似：venv 若被覆盖则重建并安装新依赖
set -uo pipefail

APP_NAME="${TRIM_APPNAME:-cups-web-print}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
DATA_DIR="${TRIM_PKGVAR:-${APP_DIR}/var}"
LOG="${DATA_DIR}/install.log"

exec >> "${LOG}" 2>&1
echo "=========================================="
echo "[$(date '+%F %T')] upgrade_callback start"

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

SERVER_DIR=""
for cand in "${APP_DIR}/server" "${APP_DIR}/target/server"; do
    if [ -f "${cand}/app.py" ]; then
        SERVER_DIR="${cand}"
        break
    fi
done
SERVER_DIR="${SERVER_DIR:-${APP_DIR}/server}"
REQUIREMENTS="${SERVER_DIR}/requirements.txt"
VENV_DIR="${DATA_DIR}/venv"
VENV_PY="${VENV_DIR}/bin/python3"

if [ -f "${REQUIREMENTS}" ] && [ -x "${VENV_PY}" ]; then
    echo "[$(date '+%F %T')] 升级 Python 依赖..."
    "${VENV_PY}" -m pip install --quiet --upgrade pip 2>&1 | tail -3
    "${VENV_PY}" -m pip install --quiet --upgrade -r "${REQUIREMENTS}" 2>&1 | tail -10
    if [ "${PIPESTATUS[0]}" -ne 0 ]; then
        echo "[$(date '+%F %T')] WARN: 依赖升级失败，旧 venv 仍可用"
    else
        echo "[$(date '+%F %T')] Python 依赖升级完成"
    fi
else
    echo "[$(date '+%F %T')] WARN: 缺少 requirements 或 venv，跳过依赖升级"
fi

# 修复数据目录权限
if [ -n "${TRIM_USERNAME:-}" ] && [ -n "${TRIM_GROUPNAME:-}" ]; then
    chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${DATA_DIR}" 2>/dev/null || true
fi

echo "[$(date '+%F %T')] upgrade_callback done"
exit 0