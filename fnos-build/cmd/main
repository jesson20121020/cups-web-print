#!/bin/bash
# cups-web-print 生命周期主入口（start/stop/status）
# 架构：service_port 模式（参考 techysy/deepseek-harness-fnos）
# Flask 监听 0.0.0.0:5000，fnOS 桌面通过 trim_http_cgi 把
# /app/cups-web-print/fngateway/* 自动反代到 localhost:5000/*（fnOS 自动剥 fngateway 前缀）
# 浏览器内 fetch /api/printers 在 NAS:5000 同源下直达 Flask 200，不依赖 base 标签
set -uo pipefail

APP_NAME="${TRIM_APPNAME:-cups-web-print}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"

# 数据目录：统一解析（见 cmd/_datadir；优先 DATA_DIR > TRIM_PKGVAR > home 软链推导的卷）
. "$(cd "$(dirname "$0")" && pwd)/_datadir"

# 监听端口（service_port 模式）
APP_PORT="${TRIM_SERVICE_PORT:-5000}"

# Python venv
VENV_PY="${DATA_DIR}/venv/bin/python3"

# 应用代码：实测 fnOS 把 app.tgz 内容直接落到 ${TRIM_APPDEST}/ 根（不是 target/server）
SERVER_DIR=""
for cand in "${APP_DIR}/server" "${APP_DIR}/target/server"; do
    if [ -f "${cand}/app.py" ]; then
        SERVER_DIR="${cand}"
        break
    fi
done
if [ -z "${SERVER_DIR}" ]; then
    echo "[$(date '+%F %T')] ERROR: 未找到应用代码（尝试 ${APP_DIR}/server 与 ${APP_DIR}/target/server）" >&2
    echo "未找到应用代码" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
    exit 1
fi

# PATH 必须含 /usr/bin（fnOS 调度脚本不导出 PATH）
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PYTHONUNBUFFERED=1

LOG_FILE="${DATA_DIR}/app.log"
FLASK_PID_FILE="${DATA_DIR}/app.pid"

log() { echo "[$(date '+%F %T')] $*" >> "${LOG_FILE}"; }

is_running() {
    local pid_file="$1"
    if [ -f "${pid_file}" ]; then
        local pid
        pid=$(cat "${pid_file}" 2>/dev/null)
        [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
    else
        return 1
    fi
}

# 找回「正在跑的本应用 Flask」：
#   pid 文件正常 -> 用它；pid 文件丢了/被别的用户占着写不进 -> 按命令行匹配进程名找回来。
# 这个兜底是必需的：老版本用 root 跑过一次会留下 root 属主的 app.pid，之后以包用户身份
# 启动时写不进 pid 文件 -> 应用中心 status 永远判定"未运行"，于是"启用一会儿又变未启用、
# 再点启用报 5000 端口被占用"。
find_running_pid() {
    local pid="" cand cmdline
    # 1) pid 文件可信就用它
    pid="$(cat "${FLASK_PID_FILE}" 2>/dev/null | tr -d '[:space:]')"
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
        printf '%s' "${pid}"
        return 0
    fi
    # 2) 谁听着 APP_PORT 就是我们的（最可靠，不依赖 pid 文件、不依赖 /proc/<pid>/cwd）
    cand="$(ss -ltnp 2>/dev/null | awk -v port=":${APP_PORT}" '$4 ~ port {print}' \
            | sed -n 's/.*pid=\([0-9]*\).*/\1/p' | head -1)"
    if [ -n "${cand}" ] && kill -0 "${cand}" 2>/dev/null; then
        cmdline="$(tr '\0' ' ' < "/proc/${cand}/cmdline" 2>/dev/null)"
        case "${cmdline}" in
            *"app.py"*|*"gateway.py"*)
                printf '%s' "${cand}"
                return 0
                ;;
        esac
    fi
    # 3) 兜底：按「本应用 venv 的 python + app.py」匹配（本机还有别的 python app.py，不能只看名字）
    for cand in $(pgrep -f "app\.py" 2>/dev/null); do
        cmdline="$(tr '\0' ' ' < "/proc/${cand}/cmdline" 2>/dev/null)"
        case "${cmdline}" in
            *"${VENV_PY}"*"app.py"*)
                printf '%s' "${cand}"
                return 0
                ;;
        esac
    done
    return 1
}

write_pid_file() {
    local pid="$1"
    if printf '%s\n' "${pid}" > "${FLASK_PID_FILE}" 2>/dev/null; then
        return 0
    fi
    # 可能是别的用户留下的 pid 文件：目录我们有写权限，先 unlink 再写
    rm -f "${FLASK_PID_FILE}" 2>/dev/null || true
    if printf '%s\n' "${pid}" > "${FLASK_PID_FILE}" 2>/dev/null; then
        return 0
    fi
    log "WARN: 无法写入 ${FLASK_PID_FILE}（权限不足），状态查询会退回按进程名匹配"
    return 1
}

start() {
    if [ ! -x "${VENV_PY}" ]; then
        log "WARN: venv 未创建 (${VENV_PY})；请确认 install_callback 已运行"
        echo "Python venv 未安装，请重新安装应用或手动执行：${VENV_PY}" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
        return 1
    fi

    mkdir -p "${DATA_DIR}/uploads" "${DATA_DIR}/previews"

    local existing_pid=""
    if existing_pid="$(find_running_pid)"; then
        write_pid_file "${existing_pid}" || true
        log "Flask 已在运行 (pid ${existing_pid})，跳过启动（不再抢占 ${APP_PORT}）"
        return 0
    fi
    # 清掉陈旧/不可写的 pid 文件，避免后面写 pid 失败
    rm -f "${FLASK_PID_FILE}" 2>/dev/null || true

    if ! is_running "${FLASK_PID_FILE}"; then
        log "启动 Flask (0.0.0.0:${APP_PORT})..."
        cd "${SERVER_DIR}"
        nohup "${VENV_PY}" -u app.py >> "${LOG_FILE}" 2>&1 &
        local flask_pid=$!
        write_pid_file "${flask_pid}" || true
        disown 2>/dev/null || true

        local i=0
        while [ "${i}" -lt 30 ]; do
            if kill -0 "${flask_pid}" 2>/dev/null && (echo > /dev/tcp/127.0.0.1/${APP_PORT}) 2>/dev/null; then
                log "Flask 已就绪 (pid ${flask_pid}, 监听 0.0.0.0:${APP_PORT})"
                break
            fi
            if ! kill -0 "${flask_pid}" 2>/dev/null; then
                log "ERROR: Flask 启动后立即退出，请查看 ${LOG_FILE}"
                echo "Flask 启动失败，请查看日志：${LOG_FILE}" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
                return 1
            fi
            sleep 1
            i=$((i + 1))
        done

        if ! kill -0 "${flask_pid}" 2>/dev/null; then
            log "ERROR: Flask 启动超时"
            return 1
        fi
    else
        log "Flask 已在运行 (pid $(cat "${FLASK_PID_FILE}"))"
    fi

    log "cups-web-print 已启动；访问路径：NAS:5000 (fnOS 桌面通过 /app/cups-web-print/fngateway/ 嵌入)"
    return 0
}

stop() {
    local pid=""
    if pid="$(find_running_pid)"; then
        log "Stopping Flask (pid ${pid})"
        write_pid_file "${pid}" || true
        kill "${pid}" 2>/dev/null || true
        local i=0
        while kill -0 "${pid}" 2>/dev/null && [ "${i}" -lt 10 ]; do
            sleep 1
            i=$((i + 1))
        done
        if kill -0 "${pid}" 2>/dev/null; then
            log "WARN: Flask 优雅退出超时，强制 kill -9"
            kill -9 "${pid}" 2>/dev/null || true
        fi
        rm -f "${FLASK_PID_FILE}"
    fi

    local leftover leftover_cmd
    for leftover in $(pgrep -f "app\.py|gateway\.py" 2>/dev/null); do
        leftover_cmd="$(tr '\0' ' ' < "/proc/${leftover}/cmdline" 2>/dev/null)"
        case "${leftover_cmd}" in
            *"${VENV_PY}"*) kill "${leftover}" 2>/dev/null || true ;;
        esac
    done
    log "cups-web-print 已停止"
    return 0
}

status() {
    local rc=3
    local pid=""
    if pid="$(find_running_pid)"; then
        write_pid_file "${pid}" || true
        echo "cups-web-print: 运行中 (Flask pid ${pid}, 端口 ${APP_PORT})"
        rc=0
    else
        echo "cups-web-print: 未运行"
        rc=3
    fi
    return "${rc}"
    exit 3
}

case "${1:-}" in
    start)  start ;;
    stop)   stop ;;
    status) status; exit $? ;;
    restart) stop; sleep 1; start ;;
    *) echo "用法: $0 {start|stop|status|restart}"; exit 1 ;;
esac